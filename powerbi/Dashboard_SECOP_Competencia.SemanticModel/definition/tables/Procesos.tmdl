table Procesos
	lineageTag: 11f27330-4635-4901-bd92-329d8b989161

	measure 'Procesos competitivos' = SUM(Procesos[procesos])
		formatString: #,0
		lineageTag: a0d86ac8-1dd4-4424-9a5a-afb126d0d210

	measure 'Total adjudicados' = SUM(Procesos[adjudicados])
		formatString: #,0
		lineageTag: 70a64c24-1a7a-42de-bb42-46d36b0d6127

	measure 'Procesos con oferente único' = SUM(Procesos[oferente_unico])
		formatString: #,0
		lineageTag: e5a8fed2-a05a-4c4f-8cb7-663467854a04

	measure '% Oferente único' = DIVIDE([Procesos con oferente único], [Total adjudicados])
		formatString: 0.0 %;-0.0 %;0.0 %
		lineageTag: 0c38c7a7-7a30-45b3-a8d9-85b3d0b6e535

	measure 'Oferentes promedio' = DIVIDE(SUM(Procesos[oferentes]), [Total adjudicados])
		formatString: 0.0
		lineageTag: 756178a1-cd00-4ed2-a1cb-4ae360065526

	measure '% Cancelados' = DIVIDE(SUM(Procesos[cancelados]), [Procesos competitivos])
		formatString: 0.0 %;-0.0 %;0.0 %
		lineageTag: a12ae6ae-0887-46d2-bc5f-ec9536128682

	measure '% Proveedor local' = DIVIDE(SUM(Procesos[proveedor_local]), SUM(Procesos[proveedor_conocido]))
		formatString: 0.0 %;-0.0 %;0.0 %
		lineageTag: c5c8b179-45b6-4d3b-9988-110bd314482f

	measure 'Valor adjudicado (billones)' = SUM(Procesos[valor_adjudicado]) / 1e12
		formatString: #,0.0
		lineageTag: fd371883-5902-4788-9ea6-50148d9640ea

	measure '% Procesos del perfil' = IF(SELECTEDVALUE(Perfiles[cluster_id]) = -1, BLANK(), DIVIDE([Total adjudicados], CALCULATE([Total adjudicados], ALL(Perfiles), Perfiles[cluster_id] <> -1)))
		formatString: 0.0 %;-0.0 %;0.0 %
		lineageTag: f910ea39-ad33-44de-985e-14bdac254ee7

	measure '% Valor del perfil' = IF(SELECTEDVALUE(Perfiles[cluster_id]) = -1, BLANK(), DIVIDE(SUM(Procesos[valor_adjudicado]), CALCULATE(SUM(Procesos[valor_adjudicado]), ALL(Perfiles), Perfiles[cluster_id] <> -1)))
		formatString: 0.0 %;-0.0 %;0.0 %
		lineageTag: 4543930a-82e0-4352-a0b3-bd95d50579fe

	measure 'Promedio % oferente único' = CALCULATE([% Oferente único], ALL(Departamentos))
		formatString: 0.0 %;-0.0 %;0.0 %
		lineageTag: 61b5eb48-1e20-40df-94bd-662d54b8939f

	measure Narrativa = "En la selección, el " & FORMAT([% Oferente único], "0.0 %") & " de los procesos competitivos adjudicados tuvo un solo oferente, con " & FORMAT([Oferentes promedio], "0.0") & " oferentes en promedio y un " & FORMAT([% Cancelados], "0.0 %") & " de procesos cancelados."
		lineageTag: d8f993fa-f68f-4055-9ade-8fc465161d16

	measure '% Oferente único (depto)' = IF(SELECTEDVALUE(Departamentos[departamento]) = "No definido" || [Total adjudicados] < 100, BLANK(), [% Oferente único])
		formatString: 0.0 %;-0.0 %;0.0 %
		lineageTag: 42c9b4be-4790-4407-99ac-d2c2caa93975

