            sourceColumn: mediana_oferentes

        column mediana_visualizaciones
            dataType: double
            sourceColumn: mediana_visualizaciones

        column mediana_duracion_dias
            dataType: double
            sourceColumn: mediana_duracion_dias

        column mediana_valor
            dataType: double
            sourceColumn: mediana_valor

        partition Perfiles = m
            mode: import
            source =
                    let
                        Origen = Csv.Document(File.Contents("C:\Users\Dario Rivera\Downloads\BigData_SECOP_Competencia\powerbi\perfiles.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                        Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
                        Tipos = Table.TransformColumnTypes(Encabezados, {{"cluster_id", Int64.Type}, {"perfil", type text}, {"orden_perfil", Int64.Type}, {"descripcion", type text}, {"mediana_oferentes", type number}, {"mediana_visualizaciones", type number}, {"mediana_duracion_dias", type number}, {"mediana_valor", type number}}, "en-US")
                    in
