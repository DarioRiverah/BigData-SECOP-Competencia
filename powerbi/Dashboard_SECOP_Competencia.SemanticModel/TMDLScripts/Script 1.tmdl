    relationship rel_Procesos_anio_Anios
        fromColumn: Procesos.anio
        toColumn: Anios.anio

    relationship rel_Segmentos_anio_Anios
        fromColumn: Segmentos.anio
        toColumn: Anios.anio

    relationship rel_Procesos_orden_Ordenes
        fromColumn: Procesos.orden
        toColumn: Ordenes.orden

    relationship rel_Segmentos_orden_Ordenes
        fromColumn: Segmentos.orden
        toColumn: Ordenes.orden

    relationship rel_Entidades_orden_Ordenes
