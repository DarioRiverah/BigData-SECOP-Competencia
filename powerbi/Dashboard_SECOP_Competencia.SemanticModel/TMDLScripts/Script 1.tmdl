createOrReplace

    table Procesos

        column anio
            dataType: int64
            summarizeBy: none
            sourceColumn: anio

        column departamento
            dataType: string
            summarizeBy: none
            sourceColumn: departamento

        column orden
            dataType: string
            summarizeBy: none
            sourceColumn: orden

        column modalidad
            dataType: string
            summarizeBy: none
            sourceColumn: modalidad

        column cluster_id
            dataType: int64
            summarizeBy: none
            sourceColumn: cluster_id

        column procesos
            dataType: int64
            sourceColumn: procesos

        column adjudicados
            dataType: int64
            sourceColumn: adjudicados

        column cancelados
            dataType: int64
            sourceColumn: cancelados

        column oferente_unico
            dataType: double
            sourceColumn: oferente_unico

        column oferentes
            dataType: double
            sourceColumn: oferentes

        column valor_adjudicado
            dataType: double
            sourceColumn: valor_adjudicado

        column visualizaciones
            dataType: int64
            sourceColumn: visualizaciones

        column proveedor_local
            dataType: double
            sourceColumn: proveedor_local

        column proveedor_conocido
            dataType: int64
            sourceColumn: proveedor_conocido

        measure 'Procesos competitivos' = SUM(Procesos[procesos])
            formatString: #,0

        measure 'Total adjudicados' = SUM(Procesos[adjudicados])
            formatString: #,0

        measure 'Procesos con oferente único' = SUM(Procesos[oferente_unico])
            formatString: #,0

        measure '% Oferente único' = DIVIDE([Procesos con oferente único], [Total adjudicados])
            formatString: 0.0 %;-0.0 %;0.0 %

        measure 'Oferentes promedio' = DIVIDE(SUM(Procesos[oferentes]), [Total adjudicados])
            formatString: 0.0

        measure '% Cancelados' = DIVIDE(SUM(Procesos[cancelados]), [Procesos competitivos])
            formatString: 0.0 %;-0.0 %;0.0 %

        measure '% Proveedor local' = DIVIDE(SUM(Procesos[proveedor_local]), SUM(Procesos[proveedor_conocido]))
            formatString: 0.0 %;-0.0 %;0.0 %

        measure 'Valor adjudicado (billones)' = SUM(Procesos[valor_adjudicado]) / 1e12
            formatString: #,0.0

        measure '% Procesos del perfil' = DIVIDE([Total adjudicados], CALCULATE([Total adjudicados], ALL(Perfiles)))
            formatString: 0.0 %;-0.0 %;0.0 %

        measure '% Valor del perfil' = DIVIDE(SUM(Procesos[valor_adjudicado]), CALCULATE(SUM(Procesos[valor_adjudicado]), ALL(Perfiles)))
            formatString: 0.0 %;-0.0 %;0.0 %

        measure 'Promedio % oferente único' = CALCULATE([% Oferente único], ALL(Departamentos))
            formatString: 0.0 %;-0.0 %;0.0 %

        measure 'Narrativa' = "En la selección, el " & FORMAT([% Oferente único], "0.0 %") & " de los procesos competitivos adjudicados tuvo un solo oferente, con " & FORMAT([Oferentes promedio], "0.0") & " oferentes en promedio y un " & FORMAT([% Cancelados], "0.0 %") & " de procesos cancelados."

        partition Procesos = m
            mode: import
            source =
                    let
                        Origen = Csv.Document(File.Contents("C:\Users\Dario Rivera\Downloads\BigData_SECOP_Competencia\powerbi\hechos_procesos.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                        Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
                        Tipos = Table.TransformColumnTypes(Encabezados, {{"anio", Int64.Type}, {"departamento", type text}, {"orden", type text}, {"modalidad", type text}, {"cluster_id", Int64.Type}, {"procesos", Int64.Type}, {"adjudicados", Int64.Type}, {"cancelados", Int64.Type}, {"oferente_unico", type number}, {"oferentes", type number}, {"valor_adjudicado", type number}, {"visualizaciones", Int64.Type}, {"proveedor_local", type number}, {"proveedor_conocido", Int64.Type}}, "en-US")
                    in
                        Tipos

    table Segmentos

        column segmento
            dataType: int64
            summarizeBy: none
            sourceColumn: segmento

        column anio
            dataType: int64
            summarizeBy: none
            sourceColumn: anio

        column orden
            dataType: string
            summarizeBy: none
            sourceColumn: orden

        column cluster_id
            dataType: int64
            summarizeBy: none
            sourceColumn: cluster_id

        column procesos
            dataType: int64
            sourceColumn: procesos

        column adjudicados
            dataType: int64
            sourceColumn: adjudicados

        column cancelados
            dataType: int64
            sourceColumn: cancelados

        column oferente_unico
            dataType: double
            sourceColumn: oferente_unico

        column oferentes
            dataType: double
            sourceColumn: oferentes

        column valor_adjudicado
            dataType: double
            sourceColumn: valor_adjudicado

        column visualizaciones
            dataType: int64
            sourceColumn: visualizaciones

        column proveedor_local
            dataType: double
            sourceColumn: proveedor_local

        column proveedor_conocido
            dataType: int64
            sourceColumn: proveedor_conocido

        column segmento_nombre
            dataType: string
            summarizeBy: none
            sourceColumn: segmento_nombre

        measure 'Adjudicados (segmento)' = SUM(Segmentos[adjudicados])
            formatString: #,0

        measure '% Oferente único (segmento)' = IF([Adjudicados (segmento)] >= 300, DIVIDE(SUM(Segmentos[oferente_unico]), [Adjudicados (segmento)]))
            formatString: 0.0 %;-0.0 %;0.0 %

        partition Segmentos = m
            mode: import
            source =
                    let
                        Origen = Csv.Document(File.Contents("C:\Users\Dario Rivera\Downloads\BigData_SECOP_Competencia\powerbi\hechos_segmentos.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                        Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
                        Tipos = Table.TransformColumnTypes(Encabezados, {{"segmento", Int64.Type}, {"anio", Int64.Type}, {"orden", type text}, {"cluster_id", Int64.Type}, {"procesos", Int64.Type}, {"adjudicados", Int64.Type}, {"cancelados", Int64.Type}, {"oferente_unico", type number}, {"oferentes", type number}, {"valor_adjudicado", type number}, {"visualizaciones", Int64.Type}, {"proveedor_local", type number}, {"proveedor_conocido", Int64.Type}, {"segmento_nombre", type text}}, "en-US")
                    in
                        Tipos

    table Entidades

        column entidad
            dataType: string
            summarizeBy: none
            sourceColumn: entidad

        column departamento
            dataType: string
            summarizeBy: none
            sourceColumn: departamento

        column orden
            dataType: string
            summarizeBy: none
            sourceColumn: orden

        column procesos_adjudicados
            dataType: int64
            sourceColumn: procesos_adjudicados

        column pct_oferente_unico
            dataType: double
            sourceColumn: pct_oferente_unico

        column oferentes_promedio
            dataType: double
            sourceColumn: oferentes_promedio

        column valor_adjudicado
            dataType: double
            sourceColumn: valor_adjudicado

        partition Entidades = m
            mode: import
            source =
                    let
                        Origen = Csv.Document(File.Contents("C:\Users\Dario Rivera\Downloads\BigData_SECOP_Competencia\powerbi\entidades.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                        Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
                        Tipos = Table.TransformColumnTypes(Encabezados, {{"entidad", type text}, {"departamento", type text}, {"orden", type text}, {"procesos_adjudicados", Int64.Type}, {"pct_oferente_unico", type number}, {"oferentes_promedio", type number}, {"valor_adjudicado", type number}}, "en-US")
                    in
                        Tipos

    table Histograma

        column cluster_id
            dataType: int64
            summarizeBy: none
            sourceColumn: cluster_id

        column oferentes
            dataType: int64
            sourceColumn: oferentes

        column procesos
            dataType: int64
            sourceColumn: procesos

        column oferentes_txt
            dataType: string
            summarizeBy: none
            sourceColumn: oferentes_txt

        measure 'Procesos (histograma)' = SUM(Histograma[procesos])
            formatString: #,0

        partition Histograma = m
            mode: import
            source =
                    let
                        Origen = Csv.Document(File.Contents("C:\Users\Dario Rivera\Downloads\BigData_SECOP_Competencia\powerbi\histograma_oferentes.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
                        Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
                        Tipos = Table.TransformColumnTypes(Encabezados, {{"cluster_id", Int64.Type}, {"oferentes", Int64.Type}, {"procesos", Int64.Type}, {"oferentes_txt", type text}}, "en-US")
                    in
                        Tipos

    table Perfiles

        column cluster_id
            dataType: int64
            summarizeBy: none
            sourceColumn: cluster_id

        column perfil
            dataType: string
            summarizeBy: none
            sourceColumn: perfil

        column orden_perfil
            dataType: int64
            sourceColumn: orden_perfil

        column descripcion
            dataType: string
            summarizeBy: none
            sourceColumn: descripcion

        column mediana_oferentes
