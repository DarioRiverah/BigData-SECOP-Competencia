    relationship rel_Procesos_departamento_Departamentos
        fromColumn: Procesos.departamento
        toColumn: Departamentos.departamento

    relationship rel_Entidades_departamento_Departamentos
        fromColumn: Entidades.departamento
        toColumn: Departamentos.departamento

    relationship rel_Procesos_cluster_id_Perfiles
        fromColumn: Procesos.cluster_id
        toColumn: Perfiles.cluster_id

    relationship rel_Segmentos_cluster_id_Perfiles
        fromColumn: Segmentos.cluster_id
        toColumn: Perfiles.cluster_id

    relationship rel_Histograma_cluster_id_Perfiles
        fromColumn: Histograma.cluster_id
        toColumn: Perfiles.cluster_id
